# SII ITC (institutional API). The frontend never calls it directly.
SII_BASE_URL=https://sii.celaya.tecnm.mx/api
SII_TIMEOUT_SECONDS=10

# Supabase → Project Settings → Database → Connection string → "Session pooler".
# Paste it as-is (postgresql://...); it is converted to the asyncpg driver automatically.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Our session lifetime (minutes). Never longer than the SII token itself.
SESSION_TTL_MINUTES=30

# Encrypts the SII token at rest so a page reload can restore the session (HttpOnly cookie).
# Any long random string, e.g. the output of:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out. If empty, a random one is used per process (dev only).
SESSION_SECRET=

# Refresh cookie `Secure` flag. Leave empty for automatic: HTTPS-only everywhere except
# localhost (Safari drops Secure cookies on http://localhost). Force with true/false.
COOKIE_SECURE=

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Comma-separated control numbers allowed to use /api/v1/admin/*.
ADMIN_CONTROL_NUMBERS=23031035
